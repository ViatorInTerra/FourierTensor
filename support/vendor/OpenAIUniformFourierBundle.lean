    digitProd M * digitProd N = digitProd (fun j => M j * N j) := by
  classical
  ext x z
  simp only [digitProd_apply, Matrix.mul_apply, ← Finset.prod_mul_distrib]
  exact (Fintype.prod_sum (fun j y => M j (x j) y * N j y (z j))).symm

