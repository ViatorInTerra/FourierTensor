  induction f with
  | atom op => rw [Code.run]; exact Atom.run_pres _ _ hx
  | comp u v hu hv =>
    rw [Code.run]
    apply Bill.Pres.pay
    exact (hu h hh x hx).pass (fun y hy => hv h hh y hy)
  | fork u v hu hv =>
    rw [Code.run]
    exact (hu h hh x hx).pass
