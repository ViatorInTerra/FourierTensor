  induction n with
  | zero => exact Bill.one_pres hx
  | succ i ih =>
    intro hm
    rw [steps] at hm ⊢
    have hg := max_le_iff.mp hm
    have hh := ih.pass (hf i (Nat.lt_of_succ_le hg.2))
    exact hh hg.1

