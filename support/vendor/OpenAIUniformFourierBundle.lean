  · simp only [digitProd_apply, diagonal_apply]
    -- diagonal if i=j then ... else 0
    rw [if_neg h]
    replace h : ∃ j, x j ≠ y j := Classical.byContradiction (by
      intro nh
      apply h
      push Not at nh
      exact funext nh)
    obtain ⟨j,hj⟩ := h
