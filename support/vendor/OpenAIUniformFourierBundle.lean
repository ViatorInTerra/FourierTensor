-- Label abbreviations (at fixed j)
def big (j : J) : Mask := rect j true univ
def belt (j : J) : Mask := big j \ rect j false univ
def xstart (j : J) (slot : H) : Mask := rect j true {slot}
def ystart (j : J) (slot : H) : Mask := xstart j slot \ rect j false {slot}
/-- Big minus P tensor the complement of the slot. -/
def xstep (j : J) (slot : H) : Mask := big j \ rect j false (univ \ {slot})
def ystep (j : J) (slot : H) : Mask := big j \ rect j false {slot}

theorem in_big (j : J) (x) : x ∈ big j ↔ future j x := by simp [big, mem_rect]
theorem in_belt (j : J) (x) : x ∈ belt j ↔ future j x ∧ ¬previous j x := by
  simp [belt, in_big, mem_rect]; tauto
theorem in_xstart (j : J) (slot : H) (x) :
    x∈xstart j slot ↔ future j x ∧ x j=slot := by simp [xstart,mem_rect]
theorem in_ystart (j : J) (slot : H) (x) :
    x∈ystart j slot ↔ future j x ∧ ¬previous j x ∧ x j=slot := by
  simp [ystart,in_xstart,mem_rect]; tauto
theorem in_xstep (j : J) (slot : H) (x) :
    x∈xstep j slot ↔ future j x ∧ (¬previous j x ∨ x j=slot) := by
  simp [xstep, in_big,mem_rect]; tauto
theorem in_ystep (j : J) (slot : H) (x) :
    x∈ystep j slot ↔ future j x ∧ (¬previous j x ∨ x j≠slot) := by
  simp [ystep, in_big,mem_rect]; tauto

lemma rect_le_big (j : J) (e : Bool) (s : Finset H) :
    rect j e s ⊆ big j :=
  fun k h => (in_big j k).2 ((mem_rect ..).1 h).1

lemma belt_drop (j : J) :
    (big j \ belt j).card = 32 := by
  have hs := rect_le_big j false univ
  have eq : big j \ belt j = rect j false univ := by
    ext k
    simp only [belt, mem_sdiff]
    have h : k ∈ rect j false univ → k∈big j := fun hh => hs hh
    tauto
  rw [eq, rect, Fintype.card_piFinset]
  rw [Finset.prod_eq_single j]
  · simp [sets]
  all_goals
    first | intro i _ hi; simp [sets, hi] | simp

/-- Compare frames by comparing the current base projectors. -/
lemma rect_proj {b d : J → OBase H} {j : J} {s t : Finset H}
    (hi : ∀ i, i ≠ j → b i = d i)
    (hh : (b j).mat s = (d j).mat t) (e : Bool) :
    (OBase.tensor b).mat (rect j e s) = (OBase.tensor d).mat (rect j e t) := by
  unfold rect
  rw [OBase.mat_rect,OBase.mat_rect]
  apply congrArg (fun f : J → Matrix H H F => digitProd f)
  funext k
  by_cases h : k=j
  · subst k; simpa [sets] using hh
  · simp [sets, h, hi k h]

lemma singleton_proj {b d : OBase H} {i k : H} (h : b.v i=d.v k) :
    b.mat {i}=d.mat {k} := by
  ext j l
  simp [OBase.mat, h]

lemma big_proj {b d : J → OBase H} {j : J} (hi : ∀ i, i ≠ j → b i = d i) :
    (OBase.tensor b).mat (big j) = (OBase.tensor d).mat (big j) :=
  rect_proj hi (by simp) _

lemma belt_proj {b d : J → OBase H} {j : J} (hi : ∀ i, i ≠ j → b i = d i) :
    (OBase.tensor b).mat (belt j) = (OBase.tensor d).mat (belt j) := by
  unfold belt
  rw [OBase.mat_sub _ _ _ (rect_le_big ..), OBase.mat_sub _ _ _ (rect_le_big ..),
    big_proj hi, rect_proj (s:=univ) (t:=univ) hi (by simp)]

lemma ystart_proj {b d : J → OBase H} {j : J} (hi : ∀ i, i ≠ j → b i = d i)
    {e f : H} (hh : (b j).v e=(d j).v f) :
    (OBase.tensor b).mat (ystart j e) = (OBase.tensor d).mat (ystart j f) := by
  have hs (e : H) : rect j false {e} ⊆ rect j true {e} := by
    intro k hk
    simp only [mem_rect] at *
    exact ⟨hk.1,(by simp),hk.2.2⟩
  have ht := rect_proj hi (singleton_proj hh)
  unfold ystart xstart
  rw [OBase.mat_sub _ _ _ (hs e), OBase.mat_sub _ _ _ (hs f), ht, ht]

lemma xstep_proj {b d : J → OBase H} {j : J} (hi : ∀ i, i ≠ j → b i = d i)
    {e f : H} (hh : (b j).v e=(d j).v f) :
    (OBase.tensor b).mat (xstep j e) = (OBase.tensor d).mat (xstep j f) := by
  unfold xstep
  rw [OBase.mat_sub _ _ _ (rect_le_big ..), OBase.mat_sub _ _ _ (rect_le_big ..), big_proj hi]
  congr 1
  apply rect_proj hi
  rw [OBase.mat_sub _ _ _ (subset_univ _), OBase.mat_sub _ _ _ (subset_univ _),
    singleton_proj hh]; simp

lemma ystep_proj {b d : J → OBase H} {j : J} (hi : ∀ i, i ≠ j → b i = d i)
    {e f : H} (hh : (b j).v e=(d j).v f) :
    (OBase.tensor b).mat (ystep j e) = (OBase.tensor d).mat (ystep j f) := by
  unfold ystep
  rw [OBase.mat_sub _ _ _ (rect_le_big ..), OBase.mat_sub _ _ _ (rect_le_big ..),
     big_proj hi, rect_proj hi (singleton_proj hh)]

end Masks

end PowerSaving.Cluster

end OAI

end

/- Upstream module OAI.Computability.FourierTransform.ScalarNetwork; sha256 121a5d597f7ae266206d6e113104c98765f30f3ff28f72ccdef64c025c3d0eb5. -/
section

namespace OAI

/-! Scalar portion of one invocation. -/
namespace PowerSaving.Cluster
open Finset Binary Matrix
noncomputable section

abbrev Center := Unit ⊕ H
abbrev Side := Trip × Trip  -- ordered X trip, Y trip, including inactive pairs
abbrev Aux := Side ⊕ Center
abbrev XY := Trip ⊕ Trip
abbrev Box := XY ⊕ Aux
instance boxDec : DecidableEq Box := inferInstance

abbrev bx (i : Trip) : Box := .inl (.inl i)
abbrev byy (i : Trip) : Box := .inl (.inr i)
abbrev bs (s : Side) : Box := .inr (.inl s)
abbrev bc (i : Center) : Box := .inr (.inr i)

def vlocal : Matrix Side Trip ℚ := fun a b =>
  if (neighbor a.1 a.2 ∧ a.1 = b) then 1 else 0

def wgt (a b : Trip) : ℚ := ((meet a b:ℚ)-1)/2

def jlocal : Matrix Trip Side ℚ := fun a b =>
  if (neighbor b.1 b.2 ∧ a = b.2) then -wgt b.1 b.2 else 0

def glocal : Matrix Center Trip ℚ
  | .inl (), _ => 1
  | .inr i, b => if i∈b.val then 1 else 0

def rlocal (b : Trip) : Center → ℚ
  | .inl () => -1/2
  | .inr i => (if i∈b.val then 1 else 0)/2

abbrev rmat : Matrix Trip Center ℚ := Matrix.of rlocal

theorem rg_entry (x y : Trip) :
    (rmat * glocal) x y = wgt y x := by
  rw [Matrix.mul_apply, Fintype.sum_sum_type]
  simp only [rlocal, rmat, Matrix.of_apply, glocal, Finset.univ_unique,
    Finset.sum_singleton]
  unfold wgt
  rw [← meet_ind (R:=ℚ) y x]
  have ht (i : H) :
      ((if i∈x.val then (1:ℚ) else 0)/2)*(if i∈y.val then 1 else 0)
      = ((if i∈y.val then 1 else 0)*(if i∈x.val then 1 else 0))/2 := by ring
  simp_rw [ht]
  rw [← Finset.sum_div]
  ring

theorem jv_entry (x y : Trip) :
    (jlocal * vlocal) x y = if neighbor y x then -wgt y x else 0 := by
  rw [Matrix.mul_apply, Finset.sum_eq_single (y,x)]
  · by_cases h : neighbor y x <;> simp [jlocal, vlocal,h]
  · intro b _ hb
    by_cases h : x=b.2
    · have hh : b.1 ≠ y := fun g => hb (Prod.ext g h.symm)
      simp [vlocal, hh]
    · simp [jlocal, h]
  · simp

/-- Crucial projection identity. -/
theorem rg_jv : rmat * glocal + jlocal * vlocal = 1 := by
  ext x y
  rw [Matrix.add_apply, rg_entry, jv_entry, one_apply]
  by_cases h : x=y
  · subst y
    norm_num [wgt, neighbor,meet_self]
  · rw [if_neg h]
    split
    next hh => ring
    next hh =>
      have hj := meet_le y x (Ne.symm h)
      unfold neighbor at hh
      have eq : meet y x=1 := by omega
      simp [wgt,eq]

abbrev Q := Matrix Box Box ℚ

def takeAux (M : Matrix Aux XY ℚ) : Q := fromBlocks 0 0 M 0
def giveAux (M : Matrix XY Aux ℚ) : Q := fromBlocks 0 M 0 0

def eV : Q := takeAux (fromBlocks vlocal 0 0 0)
def eG : Q := takeAux (fromBlocks 0 0 glocal 0)
def eJ : Q := giveAux (fromBlocks 0 0 jlocal 0)
def eR : Q := giveAux (fromBlocks 0 0 0 rmat)

def eXY : Q := fromBlocks (fromBlocks 0 0 1 0 : Matrix XY XY ℚ) 0 0 0

theorem zero_VV : eV*eV=0 := by
  simp [eV, takeAux, fromBlocks_multiply]
theorem zero_GG : eG*eG=0 := by
  simp [eG, takeAux, fromBlocks_multiply]
theorem zero_JJ : eJ*eJ=0 := by
  simp [eJ, giveAux, fromBlocks_multiply]
theorem zero_RR : eR*eR=0 := by
  simp [eR, giveAux, fromBlocks_multiply]
theorem zero_XX : eXY*eXY=0 := by
  simp [eXY, fromBlocks_multiply]

/-- Multiplier from the eight rows (chronologically right to left). -/
def net : Q :=
  (((1-eV)*(1-eG))*((1+eJ)*(1+eR))) * (((1+eG)*(1+eV))*((1-eR)*(1-eJ)))

private theorem rect_commute {X Y : Q} (a : X*X=0) (b : Y*Y=0) (h : X*Y=0) :
    ((1-X)*(1+Y))*((1+X)*(1-Y))= 1+ Y*X := by
  simp only [_root_.add_mul, _root_.mul_add, _root_.sub_mul, _root_.mul_sub, one_mul, mul_one, h,b,a,zero_mul,mul_zero]
  abel

theorem net_eq : net = 1 + eXY := by
  let A := eG+eV
  let B := eJ+eR
  have ha : ((1-eV)*(1-eG):Q)=1-A := by
    have hh : eV*eG=0 := by simp [eV,eG,takeAux,fromBlocks_multiply]
    dsimp [A]
    simp [_root_.sub_mul,_root_.mul_sub,hh]; abel
  have hb : ((1+eJ)*(1+eR):Q)=1+B := by
    have hh : eJ*eR=0 := by simp [eR,eJ,giveAux,fromBlocks_multiply]
    dsimp [B]
    simp [_root_.add_mul,_root_.mul_add,hh]; abel
  have hc : ((1+eG)*(1+eV):Q)=1+A := by
    have hh : eG*eV=0 := by simp [eV,eG,takeAux,fromBlocks_multiply]
    dsimp [A]
    simp [_root_.add_mul,_root_.mul_add,hh]; abel
  have hd : ((1-eR)*(1-eJ):Q)=1-B := by
    have hh : eR*eJ=0 := by simp [eR,eJ,giveAux,fromBlocks_multiply]
    dsimp [B]
    simp [_root_.sub_mul,_root_.mul_sub,hh]; abel
  have ae : A = takeAux (fromBlocks vlocal 0 glocal 0) := by
    simp only [A, takeAux, eG,eV]; simp [fromBlocks_add]
  have be : B = giveAux (fromBlocks 0 0 jlocal rmat) := by
    simp only [B, giveAux, eJ,eR]; simp [fromBlocks_add]
  have h0 : A*A=0 := by rw [ae]; simp [takeAux,fromBlocks_multiply]
  have h1 : B*B=0 := by rw [be]; simp [giveAux,fromBlocks_multiply]
  -- A*B: B outputs only Y, ignored
  have hh : A*B=0 := by rw [ae,be]; simp [giveAux,takeAux,fromBlocks_multiply]
  have hj : B*A=eXY := by
    rw [ae,be]
    simp [giveAux,takeAux,fromBlocks_multiply, eXY, ← rg_jv, add_comm]
  rw [net,ha,hb,hc,hd,rect_commute h0 h1 hh,hj]

/-- Inverse partner. -/
theorem inv_one_add {X : Q} (hh : X*X=0) : (1+X)*(1-X)=1 := by
  simp [_root_.mul_sub, _root_.add_mul, hh]
theorem inv_one_sub {X : Q} (hh : X*X=0) : (1-X)*(1+X)=1 := by
  simp [_root_.mul_add, _root_.sub_mul, hh]

end
end PowerSaving.Cluster

end OAI

end

/- Upstream module OAI.Computability.FourierTransform.NetworkLabels; sha256 3c4057cfea65c2305fb2a323feac7ecd49fbd831d84961da6130665e6db09851. -/
section

namespace OAI
namespace PowerSaving.Cluster
open Matrix Binary Finset

-- Throughout one invocation a product basis for each physical wire.
abbrev BoxBasis := Box → OBase Blocks
abbrev StartAxes := J → OBase H

def basisBox (j : J) (F : StartAxes) : BoxBasis
  | .inl (.inl i) | .inl (.inr i) => OBase.tensor (Function.update F j (tripBase i))
  | .inr (.inl s) => OBase.tensor (Function.update F j (pairBase s.1 s.2))
  | .inr (.inr _) => OBase.tensor (Function.update F j (OBase.canonical H))

abbrev Lab := Box → Mask
def stamp (x y s c d : Mask) : Lab
  | .inl (.inl _) => x
  | .inl (.inr _) => y
  | .inr (.inl p) => if neighbor p.1 p.2 then s else d
  | .inr (.inr _) => c

lemma stamp_mono {x₁ y₁ s₁ c₁ d₁ x₂ y₂ s₂ c₂ d₂ : Mask}
    (hx : x₁ ⊆ x₂) (hy : y₁ ⊆ y₂) (hs : s₁ ⊆ s₂)
    (hc : c₁ ⊆ c₂) (hd : d₁ ⊆ d₂) :
    ∀ r, stamp x₁ y₁ s₁ c₁ d₁ r ⊆ stamp x₂ y₂ s₂ c₂ d₂ r := by
  rintro ((x|y)|(s|c))
  · exact hx
  · exact hy
  · by_cases h : neighbor s.1 s.2
    · simpa only [stamp, if_pos h] using hs
    · simpa only [stamp, if_neg h] using hd
  · exact hc

def bp (j : J) := stamp (xstart j 0) (ystart j 0) ∅ ∅ ∅
def b0 (j : J) := stamp (xstart j 0) (ystart j 0) (ystart j 1) ∅ ∅
def b1 (j : J) := stamp (xstart j 0) (belt j) (ystart j 1) (belt j) ∅
def b2 (j : J) := stamp (xstep j 0) (belt j) (xstep j 0) (belt j) ∅
def b3 (j : J) := stamp (big j) (belt j) (xstep j 0) (big j) ∅
def b4 (j : J) := stamp (big j) (belt j) (xstep j 0) (belt j) ∅
def b5 (j : J) := stamp (big j) (ystep j 0) (ystep j 1) (belt j) ∅
def b6 (j : J) := stamp (big j) (ystep j 0) (ystep j 1) (big j) ∅
def b7 (j : J) := stamp (big j) (ystep j 0) (big j) (big j) ∅
def bend (j : J) := stamp (big j) (ystep j 0) univ univ univ

lemma inc_bp_b0 (j : J) : ∀ r, bp j r ⊆ b0 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | simp


lemma inc_b0_b1 (j : J) : ∀ r, b0 j r ⊆ b1 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | (try simp (config := { failIfUnchanged := false }))
  · intro k hk
    rw [in_belt]
    rw [in_ystart] at hk
    tauto

lemma inc_b1_b2 (j : J) : ∀ r, b1 j r ⊆ b2 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | (try simp (config := { failIfUnchanged := false }))
  · intro k hk
    rw [in_xstep]
    rw [in_xstart] at hk
    tauto
  · intro k hk
    rw [in_xstep]
    rw [in_ystart] at hk
    tauto

lemma inc_b2_b3 (j : J) : ∀ r, b2 j r ⊆ b3 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | (try simp (config := { failIfUnchanged := false }))
  · intro k hk
    rw [in_big]
    rw [in_xstep] at hk
    tauto
  · intro k hk
    rw [in_big]
    rw [in_belt] at hk
    tauto

lemma loss34 (j : J) :
    loss (b3 j) (b4 j)=33*32 := by
  -- exactly centers
  unfold loss
  rw [Fintype.sum_sum_type, Fintype.sum_sum_type, Fintype.sum_sum_type]
  simp [b3,b4,stamp,belt_drop]

lemma inc_b4_b5 (j : J) : ∀ r, b4 j r ⊆ b5 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | (try simp (config := { failIfUnchanged := false }))
  · intro k hk
    rw [in_ystep]
    rw [in_belt] at hk
    tauto
  · intro k hk
    rw [in_ystep]
    rw [in_xstep] at hk
    -- if slot=0 then slot≠1
    obtain ⟨hf,h|h⟩ := hk
    · tauto
    · exact ⟨hf, Or.inr (by rw [h]; exact piv)⟩

lemma inc_b5_b6 (j : J) : ∀ r, b5 j r ⊆ b6 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | (try simp (config := { failIfUnchanged := false }))
  · intro k hk
    rw [in_big]
    rw [in_belt] at hk
    tauto

lemma inc_b6_b7 (j : J) : ∀ r, b6 j r ⊆ b7 j r := by
  apply stamp_mono <;> first | exact fun _ h => h | (try simp (config := { failIfUnchanged := false }))
  · intro k hk
    rw [in_big]
    rw [in_ystep] at hk
    tauto

lemma inc_b7_bend (j : J) : ∀ r, b7 j r ⊆ bend j r := by
  apply stamp_mono <;> first | exact fun _ h => h | simp


/-- A support condition checks the Gate/projection interaction. -/
def syncBox (j : J) (F : StartAxes) (L : Lab) (Q : Matrix Box Box ℚ) :=
  ∀ i k, Q i k ≠ 0 →
    ((basisBox j F i).mat (L i)) = ((basisBox j F k).mat (L k))

lemma upd_same (j : J) (F : StartAxes) (u v : OBase H) :
    ∀ k, k ≠ j → Function.update F j u k = Function.update F j v k := by
  intro k h; simp [Function.update_of_ne h]

lemma sync_J (j : J) (F : StartAxes) (L : Lab)
    (h : ∀ a : Side, neighbor a.1 a.2 →
      (basisBox j F (byy a.2)).mat (L (byy a.2)) =
      (basisBox j F (bs a)).mat (L (bs a))) :
    syncBox j F L eJ := by
  rintro ((x|y)|(s|c)) ((x'|y')|(s'|c')) hh <;>
    simp only [eJ, giveAux, Matrix.fromBlocks_apply₁₁,Matrix.fromBlocks_apply₁₂,
               Matrix.fromBlocks_apply₂₁,Matrix.fromBlocks_apply₂₂,
               Matrix.zero_apply, ne_eq, not_true] at hh
  unfold jlocal at hh
  split at hh
  next he =>
    have eq := he.2
    subst y
    exact h s' he.1
  next he => contradiction

lemma sync_R (j : J) (F : StartAxes) {x s c d}
    (hc : c=belt j) : syncBox j F (stamp x (belt j) s c d) eR := by
  subst c
  rintro ((x|y)|(s|c)) ((x'|y')|(s'|c')) hh <;>
    simp only [eR, giveAux, Matrix.fromBlocks_apply₁₁,Matrix.fromBlocks_apply₁₂,
               Matrix.fromBlocks_apply₂₁,Matrix.fromBlocks_apply₂₂,
               Matrix.zero_apply, ne_eq, not_true] at hh
  apply belt_proj
  exact upd_same j F _ _  -- match?

lemma sync_V (j : J) (F : StartAxes) (L : Lab)
    (h : ∀ a : Side, neighbor a.1 a.2 →
      (basisBox j F (bs a)).mat (L (bs a)) =
      (basisBox j F (bx a.1)).mat (L (bx a.1))) :
    syncBox j F L eV := by
  rintro ((x|y)|(s|c)) ((x'|y')|(s'|c')) hh <;>
    simp only [eV,takeAux, Matrix.fromBlocks_apply₁₁,Matrix.fromBlocks_apply₁₂,
               Matrix.fromBlocks_apply₂₁,Matrix.fromBlocks_apply₂₂,
               Matrix.zero_apply, ne_eq, not_true] at hh
  unfold vlocal at hh
  split at hh
  next he =>
    have eq := he.2
    subst x'
    exact h s he.1
  next he => contradiction

lemma sync_G (j : J) (F : StartAxes) {s y c d}
    (hc : c=big j) : syncBox j F (stamp (big j) y s c d) eG := by
  subst c
  rintro ((x|y)|(s|c)) ((x'|y')|(s'|c')) hh <;>
    simp only [eG,takeAux, Matrix.fromBlocks_apply₁₁,Matrix.fromBlocks_apply₁₂,
               Matrix.fromBlocks_apply₂₁,Matrix.fromBlocks_apply₂₂,
               Matrix.zero_apply, ne_eq, not_true] at hh
  apply big_proj; exact upd_same j F _ _

lemma sync0 (j : J) (F : StartAxes) : syncBox j F (b0 j) eJ := by
  apply sync_J
  intro p h
  simp only [b0,  stamp, if_pos h, basisBox]
  apply ystart_proj (upd_same j F _ _)
  simp [h]
lemma sync1 (j : J) (F : StartAxes) : syncBox j F (b1 j) eR :=
  sync_R j F rfl
lemma sync2 (j : J) (F : StartAxes) : syncBox j F (b2 j) eV := by
  apply sync_V
  intro p h
  simp only [b2, stamp,if_pos h,basisBox]
  apply xstep_proj (upd_same j F _ _)
  simp [h]
lemma sync3 (j : J) (F : StartAxes) : syncBox j F (b3 j) eG :=
  sync_G j F rfl
lemma sync4 (j : J) (F : StartAxes) : syncBox j F (b4 j) eR :=
  sync_R j F rfl
lemma sync5 (j : J) (F : StartAxes) : syncBox j F (b5 j) eJ := by
  apply sync_J
  intro p h
  simp only [b5, stamp,if_pos h,basisBox]
  apply ystep_proj (upd_same j F _ _)
  simp [h]
lemma sync6 (j : J) (F : StartAxes) : syncBox j F (b6 j) eG :=
  sync_G j F rfl
lemma sync7 (j : J) (F : StartAxes) : syncBox j F (b7 j) eV := by
  apply sync_V
  intro p h
  simp only [b7, stamp,if_pos h,basisBox]
  exact big_proj (upd_same j F _ _)

end PowerSaving.Cluster

end OAI

end

/- Upstream module OAI.Computability.FourierTransform.NetworkInvocation; sha256 1f3a4c4b9f30548c76a2c999c239f8ed9f5480b9a14671deba01ed37b092abb7. -/
section

namespace OAI

namespace PowerSaving.Cluster
open Matrix Binary Finset
noncomputable section

/-- Conveniently prove the shear and inverse-transpose shear together. -/
def DPath (j : J) (F : StartAxes) (s t : Lab) (M : Q) (d : ℕ) : Prop :=
  let A := basisBox j F
  ∃ N : Q, M * N = 1 ∧ Path A s t (actPoint M) d ∧ Path A s t (actPoint Nᵀ) d

lemma rat_if (P : Prop) [Decidable P] :
    (((if P then 1 else 0):ℚ):ℂ) = if P then 1 else 0 := by split <;> simp_all

