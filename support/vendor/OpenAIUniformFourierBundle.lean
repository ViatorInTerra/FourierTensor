  obtain ⟨d,hd⟩ := a
  obtain ⟨e,he⟩ := b
  exact ⟨e*d, fun i => (he i).trans (by simpa [mul_assoc] using Nat.mul_le_mul_left e (hd i))⟩

end Dom
