theorem Atom.run_pres (op : Atom m s t) (x : s.T) (hx : Ty.fits l s x) :
    (op.run x).Pres l (Ty.fits l t) := by
  cases op with
  | lit => intro h; exact h
  | int f =>
    rcases x with ⟨i,j⟩
    cases f <;> intro h <;> exact h
  | cz => intro; trivial
  | cone => intro; trivial
  | add => intro; trivial
  | sub => intro; trivial
  | scale => intro; trivial
  | inv => intro; trivial
  | cross => intro; trivial
  | id => intro; exact hx
  | fst =>
    intro
    change Ty.fits _ _ _ ∧ Ty.fits _ _ _ at hx
    exact hx.1
  | snd =>
    intro
    change Ty.fits _ _ _ ∧ Ty.fits _ _ _ at hx
    exact hx.2
  | len =>
    intro h
    exact h
  | @look t =>
    rcases x with ⟨v,i⟩
    intro h
    change Ty.fits l _ (v.look i t.blank)
    unfold Tape.look
    split
    · exact hx.1.2 _
    · exact Ty.fits_blank _ _

