  by_cases h : x = y
  · simp [h]
  · rw [if_neg h]
    replace h : ∃ j, x j ≠ y j := Classical.byContradiction (by
      intro nh
      apply h
      push Not at nh
      exact funext nh)
    rcases h with ⟨j,hj⟩
    exact Finset.prod_eq_zero (Finset.mem_univ j) (if_neg hj)

