  simp only [freq,mul_sum]
  rw [sum_comm]
  simp only [← mul_assoc,← sum_mul]
  refine Eq.trans (b := ∑ j ∈ range n, (if i=j then (n:ℂ) else 0) * x j) ?_ ?_
  · exact sum_congr rfl fun j hj => by rw [orth hu i j hi (mem_range.mp hj)]
  · simp [ite_mul, hi]

