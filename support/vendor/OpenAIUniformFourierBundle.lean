def forward (x : Box→ℂ) : Box→ℂ
  | .inl (.inr i) => x (byy i) + x (bx i)
  | r => x r

def backward (x : Box→ℂ) : Box→ℂ
  | .inl (.inl i) => x (bx i) - x (byy i)
  | r => x r

