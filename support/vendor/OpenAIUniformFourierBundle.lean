namespace OAI

namespace PowerSaving.RAM
open Ty Slant Slant.Stroke Complex
noncomputable section

universe U V
namespace Bench
variable {m : Bool} {ι : Type U} {κ : Type V} {b : Bench m ι} {q : Bench m κ}

structure Spots (b : Bench m ι) (u : ι→Zone) : Prop where
  low : b.Digit (fun i => (u i).lo)
  wide : b.Digit (fun i => (u i).wide)

namespace Spots
variable {u v : ι→Zone} {n : ι→ℕ}
lemma transfer {f : ι→κ} {x : κ→Zone} (h : q.Spots x) (g : b.Feeds q f) :
    b.Spots (fun i => x (f i)) := ⟨draw g h.low,draw g h.wide⟩
lemma has (h : b.Spots u) {x} (hh : b.Digit x) :
    b.Study (fun i => (u i).has (x i)) :=
  (Study.le h.low hh).both (Study.lt hh (h.low.add h.wide))

lemma overlay (h : b.Spots u) {x} (hh : b.Digit x) {l : ι→Line}
    (g : b.Fabric (fun i => (u i).wide) l) {p} (hk : b.Hue p) :
    b.Hue (fun i => if (u i).has (x i) then l i (x i-(u i).lo) else p i) := by
  let P i := (u i).has (x i)
  have H := h.has hh
  refine Hue.fork H ?_ (hk.transfer (restricted b fun i => ¬P i))
  have M := restricted b P
  have hu (i : {i // P i}) := (u i.val).enter i.property
  exact (g.transfer M).pick (draw M (hh.sub h.low)).run hu

lemma shade (h : b.Spots u) (k : b.Spots v) {l g : ι→Line}
    (hf : b.Fabric (fun i => (u i).wide) l)
    (hg : b.Fabric (fun i => (v i).wide) g) (hn : b.Digit n)
    (ha : ∀ i,(u i).Fits (n i)) (hb : ∀ i,(v i).Fits (n i)) :
    b.Engrave n (fun i => Slant.shade (u i) (v i) (l i) (g i)) := by
  unfold Slant.shade
  refine Engrave.single (Band.fresh hn ?_ ?_)
  · intro i; exact sound_shade (f:=l i) (g:=g i) (ha i) (hb i) 0 (show 0<1 by omega)
  · have H := Feeds.scan b n
    have hx := slot hn
    exact hx.run.pair ((((h.transfer H).overlay hx (hf.transfer H)
      ((k.transfer H).overlay hx (hg.transfer H) Hue.one)).bright).pair hx.run)

lemma finds (h : b.Spots u) (k : b.Spots v) {x} (hh : b.Digit x) :
    b.Digit (fun i => Slant.jumps (u i) (v i) (x i)) :=
  iteN (h.has hh) (k.low.add (hh.sub h.low))
    (iteN (k.has hh) (h.low.add (hh.sub k.low)) hh)

lemma snap (h : b.Spots u) (k : b.Spots v) (hn : b.Digit n)
    (ha : ∀ i,(u i).Fits (n i)) (hb : ∀ i,(v i).Fits (n i))
    (hx : ∀ i,(u i).wide=(v i).wide) (hg : ∀ i,(u i).Sep (v i)) :
    b.Engrave n (fun i => Slant.snap (u i) (v i)) := by
  unfold Slant.snap
  refine Engrave.single (Band.fresh hn ?_ ?_)
  · intro i; exact sound_snap (ha i) (hb i) (hx i) (hg i) 0 (show 0<1 by omega)
  · have H := Feeds.scan b n
    exact (slot hn).run.pair (Makes.one.pair
      (((h.transfer H).finds (k.transfer H) (slot hn)).run))

lemma slim (h : b.Spots u) (k : b.Digit n) :
    b.Spots (fun i => (u i).slim (n i)) := ⟨h.low,k⟩

end Spots

/- Numeric convenience -/
lemma Hue.smallNumeral (b : Bench m ι) (n : ℕ) [Nat.AtLeastTwo n] :
    b.Hue (fun _ => (OfNat.ofNat n:ℂ)) := (Hue.numeral n).congr fun _ => rfl

section
variable {n : ι→ℕ} {u v : ι→Zone} (h : b.Spots u) (k : b.Spots v)
    (hn : b.Digit n)
    (ha : ∀ i,(u i).Fits (n i)) (hb : ∀ i,(v i).Fits (n i))
    (hx : ∀ i,(u i).wide=(v i).wide) (hg : ∀ i,(u i).Sep (v i))
    (hy : b.Hue fun _ => I)

include h k hn ha hb hx hg hy

lemma Spots.hinge :
    b.Engrave n (fun i => Slant.hinge (u i) (v i)) :=
  ((h.shade k Fabric.one (Fabric.flat hy) hn ha hb).stack (h.snap k hn ha hb hx hg)).stack
    (h.shade k (Fabric.flat (Hue.one.sub hy)) (Fabric.flat (Hue.one.add hy)) hn ha hb)

lemma Spots.brick :
    b.Engrave n (fun i => Slant.brick (u i) (v i)) :=
  have H := h.hinge k hn ha hb hx hg hy
  have p := h.shade k (Fabric.flat (Hue.smallNumeral b 3).neg) Fabric.one hn ha hb
  have q := h.shade k (Fabric.flat (Hue.smallNumeral b 2)) Fabric.one hn ha hb
  (((H.stack p).stack H).stack q).stack H

lemma Spots.spark {f : ι→Line}
    (hh : b.Fabric (fun i => (u i).wide) f) (hf : ∀ i, ∀ j<(u i).wide, f i j ≠ 0) :
    b.Engrave n (fun i => Slant.spark (u i) (v i) (f i)) := by
  let F (i : ι) : Line := fun j => 4*f i j/5
  let U i := (u i).wide
  have H : b.Fabric U F :=
    Hue.div ((Hue.smallNumeral (b.scan U) 4).mul hh) (Hue.smallNumeral _ 5)
      (by intro i; norm_num)
  have hx' : ∀ i, ∀ j<U i, F i j≠0 := fun i j hj => by simp [F,hf i j hj]
  have hc6 : b.Hue (fun _ => -1/6) := Hue.one.neg.div (Hue.smallNumeral _ 6) (by
    intro i; norm_num)
  have hc8 : b.Hue (fun _ => -1/8) := Hue.one.neg.div (Hue.smallNumeral _ 8) (by
    intro i; norm_num)
  have hP := h.shade k (H.inv hx') Fabric.one hn ha hb
  have hQ := h.shade k ((Fabric.flat hc8).mul H) (Fabric.flat hc6) hn ha hb
  exact (hP.stack (h.brick k hn ha hb hx hg hy)).stack hQ

lemma Spots.flash {f : ι→Line} (hh : b.Fabric (fun i => (u i).wide) f) :
    b.Engrave n (fun i => Slant.flash (u i) (v i) (f i)) := by
  have hk : b.Fabric (fun i => (u i).wide) (fun i => blaze (f i)) :=
    Fabric.one.add (hh.mul hh.flip)
  exact (h.spark k hn ha hb hx hg hy hk (fun i j _ => blaze_ne _ _)).stack
    (h.spark k hn ha hb hx hg hy (hh.sub hk) (fun i j _ => after_ne _ _))

end

lemma engrave_cameo {n : ι→ℕ} {p u v z : ι→Reel}
    (hp : b.Engrave n p) (hu : b.Engrave n u)
    (hv : b.Engrave n v) (hz : b.Engrave n z) :
    b.Engrave n fun i => cameo (p i) (u i) (v i) (z i) :=
  ((hp.stack hu).stack hv).stack hz

end Bench
end
end PowerSaving.RAM

end OAI

end

/- Upstream module OAI.Computability.FourierTransform.ScalarPreparation; sha256 1c61342491f4871f8e921c359e74b64c38f3b7c3eccf99ab9b16a399aa635a8e. -/
section

namespace OAI

namespace PowerSaving.RAM
open Ty Slant Slant.Stroke Complex
noncomputable section

universe U V
namespace Bench
variable {m : Bool} {ι : Type U} {κ : Type V} {b : Bench m ι} {q : Bench m κ}

/-- exponent with both it and the power of two available in polynomial resources. -/
structure Arch (b : Bench m ι) (e : ι→ℕ) : Prop where
  ep : b.Digit e
  span : b.Digit (fun i => 2^e i)

namespace Arch
lemma transfer {e : κ→ℕ} (h : q.Arch e) {f : ι→κ} (F : b.Feeds q f) :
    b.Arch (fun i => e (f i)) :=
  ⟨draw F h.ep,draw F h.span⟩
variable {e d : ι→ℕ}

lemma fromSmall (h : b.Digit e) (g : Small b.size (fun i => 2^e i)) :
    b.Arch e := ⟨h,h.two g⟩

lemma below (h : b.Arch e) (hh : b.Digit d) (g : ∀ i,d i ≤ e i) :
    b.Arch d :=
  fromSmall hh (h.span.small.mono fun i => Nat.pow_le_pow_right (by omega) (g i))

lemma succ (h : b.Arch e) :
    b.Arch (fun i => e i+1) :=
  ⟨h.ep.add (Digit.wc 1), (h.span.mul (Digit.wc 2)).congr (fun _ => (pow_succ ..).symm)⟩

lemma sub (h : b.Arch e) (g : b.Digit d) :
    b.Arch (fun i => e i-d i) :=
  h.below (h.ep.sub g) fun _ => Nat.sub_le ..
end Arch

section
variable {u : ι→ℂ} {n : ι→ℕ}

lemma powers_fabric (h : b.Hue u) (ha : b.Digit n) :
    b.Fabric n (fun i j => u i ^ j) :=
  (h.transfer (Feeds.scan b n)).exponent (slot ha)

lemma print_fold (hy : b.Hue fun _ => I) (h : b.Hue u)
    (ha : b.Digit n) :
    b.Engrave (fun i => n i+n i) (fun i => foldPair (n i) (u i)) := by
  let F i := initial (n i); let G i := ending (n i)
  have hf : b.Spots F := ⟨Digit.wc 0,ha⟩
  have hg : b.Spots G := ⟨ha,ha⟩
  have hr i := (half_fits (n i)).1
  have hs i := (half_fits (n i)).2
  exact (hf.shade hg Fabric.one (powers_fabric h ha) (ha.add ha) hr hs).stack
    (hf.hinge hg (ha.add ha) hr hs (fun _ => rfl) (fun _ => half_sep _) hy)

lemma print_deal (h : b.Digit n) :
    b.Engrave (fun i => n i+n i) (fun i => Reel.lace (n i+n i) (deal (n i))) := by
  let W i := n i+n i
  have hh := h.add h
  refine Engrave.lace (fun i => deal (n i)) hh ?_ ?_
  · intro i j hj; unfold deal; dsimp only; split <;> omega
  · have hk := slot hh
    have hn := draw (Feeds.scan b W) h
    exact (iteN (Study.lt hk hn) ((Digit.wc 2).mul hk)
      (((Digit.wc 2).mul (hk.sub hn)).add (Digit.wc 1))).run

lemma print_duo (hy : b.Hue fun _ => I) (h : b.Hue u)
    {p : ι→Reel} (g : b.Engrave n p) :
    b.Engrave (fun i => n i+n i) (fun i => duo (n i) (u i) (p i)) :=
  ((print_deal g.width).stack (g.parallel g (fun _ => rfl))).stack
    (print_fold hy h g.width)

end

variable {e : ι→ℕ} {r : ι→ℂ}

private def towerNote (k i : ℕ) (r : ℂ) := r ^ (2^(k-i):ℕ)

private lemma note_change (r : ℂ) (k i : ℕ) (hi : i<k) :
    towerNote k i r = towerNote k (i+1) r ^ 2 := by
  unfold towerNote
  rw [← pow_mul, show k-i=k-(i+1)+1 by omega, pow_succ]

lemma pulse_duration (h : b.Digit e) (r : ι→ℂ) :
    b.Digit (tickCount fun i => pulse (e i) (r i)) :=
  ((Digit.wc 5).mul h).congr (fun _ => (beats_pulse _ _).symm)

lemma print_pulse (hy : b.Hue fun _ => I) (h : b.Arch e) (g : b.Hue r) :
    b.Engrave (fun i => 2^e i) (fun i => pulse (e i) (r i)) := by
  let u i j := towerNote (e i) j (r i)
  let R i (j : ℕ) := pulse j (u i j)
  let Z i (j : ℕ) := film (2^j) (R i j)
  have hf : b.Makes filmTy (fun i => Z i (e i)) := by
    refine loop (t:=filmTy) h.ep Z ?_ ?_
    · have H := (Engrave.rest (b:=b) (Digit.wc 1) (Digit.wc 0)).layers
      exact H.congr (fun i => by simp only [Z,R,pulse,pow_zero])
    · let P := b.climbs e filmTy Z
      have F := Feeds.climbs b e Z -- specify
      have hw : P.Digit During.j := stepi h.ep Z
      have hs : P.Arch During.j := (h.transfer F).below hw (fun i => i.hj.le)
      let d (i : During e) := u i.i (i.j+1)
      have hd : P.Hue d :=
        (g.transfer F).exponent (((h.transfer F).sub (hw.add (Digit.wc 1))).span)
      let p (i : During e) := R i.i i.j
      have ha : P.Engrave (fun i => 2^i.j) p :=
        ⟨fun i => sound_pulse _ _,pulse_duration hw _,hs.span,stepsum (t:=filmTy) b e Z⟩
      -- add one step; equality only on the requested index range
      refine (print_duo (hy.transfer F) hd ha).layers.congr ?_
      intro i
      simp only [Z,R,p,d,pow_succ (2:ℕ),mul_two]
      rw [pulse]
      have hx : u i.i i.j=u i.i (i.j+1)^2 := note_change _ _ _ i.hj
      rw [hx]
  have H : b.Engrave (fun i => 2^e i) (fun i => R i (e i)) :=
    ⟨fun i => sound_pulse _ _,pulse_duration h.ep _,h.span,hf⟩
  refine H.congr (fun _ => rfl) ?_
  intro i; unfold R u towerNote; simp

lemma print_backPulse (hy : b.Hue fun _ => I) (h : b.Arch e)
    (g : b.Hue r) (hg : ∀ i, r i≠0) :
    b.Engrave (fun i => 2^e i) (fun i => backPulse (e i) (r i)) := by
  have hp := print_pulse hy h (g.inv hg)
  have hh := (Hue.casting h.span).inv (by intro i; exact Nat.cast_ne_zero.mpr (by positivity))
  exact hp.stack (Engrave.swatch h.span _ (Fabric.flat hh))

end Bench
end
end PowerSaving.RAM

end OAI

end

