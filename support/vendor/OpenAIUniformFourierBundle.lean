  rw [← exp_nat_mul]
  have hm' : (m:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hn' : (n:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
