    (u : ∀ i, Grid (Minus j) r (f i) × Bits (f i))
    (h : Knows m B s x (fun i => (book X' r (f i)).loc (u i).1))
    (k : Knows m B s x (fun i => (bits (f i)).loc (u i).2)) :
