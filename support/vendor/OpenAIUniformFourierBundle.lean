  have hd : Dom W B := Dom.of_le (fun i => Nat.le_mul_of_pos_right _ (hills_pos _))
  have he : Dom W (fun i => (M i).n) := by
    refine hd.trans ?_
    refine ⟨R.n+1,fun i => ?_⟩
    change R.n*B i+1 ≤ _
    simp only [mul_add,add_mul,mul_one,one_mul]
    gcongr <;> simp
