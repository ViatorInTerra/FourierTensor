import work_in_progress.OriginalGroupedBodyInstantiationRAM
import work_in_progress.OriginalNativeBankDAG

/-!
Close actual shared bank DAGs with explicitly initialized and cleared fresh
scratch.  Only ORIGINAL roles supply physical role bits and the recurrence
denominator.  Every original role is arbitrary complex data.  The finite
DAG's native frame requests, their spectator multiplicities, all local
arithmetic and preparation, and both input and output routing remain paid.
This construction makes no improved moment claim for the projection DAG.
-/
namespace FourierSchur.OriginalScratchGroupedBodyRAM
open OAI.PowerSaving OAI.PowerSaving.Binary OAI.PowerSaving.RAM
open OAI.PowerSaving.RAM.Ty Matrix Finset
open OriginalGroupedWordRAM OriginalGroupedPhysicalBits OriginalGroupedRoleBitsRAM
open OriginalNativeBankDAG OriginalLocalizedBankWorkspaceRAM
open OriginalGroupedRecursionRAM
open scoped BigOperators
noncomputable section
set_option maxHeartbeats 1000000

variable {α η κ : Type*} [Fintype α] [DecidableEq α]
  [Fintype η] [DecidableEq η] [Fintype κ] [DecidableEq κ]

def kernelGrain {r f : ℕ} (v : Grain α η r f) : Grain α η r f :=
  fun q => matAct f (kernel α) (fun z => v (q.1,q.2.1,z)) q.2.2

/-- An exact certificate on the original independent banks.  Native scratch
creation and clearing are generated by `programWord`, not assumed here. -/
def KernelDAG (A : (η⊕κ)→OBase α) (nodes : List (Node α η κ))
    (D : Matrix η (η⊕κ) ℚ) : Prop :=
  ∀ (f : ℕ) (x : Data α (η⊕κ) f) (j : η),
    OriginalGroupedFrameWords.walk A f (programWord nodes D) x (.inl j)=
      matAct f (kernel α) (x (.inl j))

theorem coastline_kernel (A : (η⊕κ)→OBase α) (nodes : List (Node α η κ))
    (D : Matrix η (η⊕κ) ℚ) (H : KernelDAG A nodes D)
    {r f : ℕ} (v : Grain α η r f) :
    coastline A r f (programWord nodes D) (padded (κ:=κ) v)=
      padded (κ:=κ) (kernelGrain v) := by
  funext q
  rcases q with ⟨role,s,z⟩
  cases role with
  | inl j =>
    change OriginalGroupedFrameWords.walk A f (programWord nodes D)
      (fun l t => padded v (l,s,t)) (.inl j) z=_
    rw [H]
    rfl
  | inr j =>
    change OriginalGroupedFrameWords.walk A f (programWord nodes D)
      (fun l t => padded v (l,s,t)) (.inr j) z=_
    rw [programWord_correct,evaluate_scratch]
    rfl

section Native
universe U
variable {ι : Type U} {m : Bool} {B f : ι→ℕ}
  {s : Ty} {x : ι→T s} {cl : Paint} {X : Layout α}
  {R0 : Layout η} {R : Layout (η⊕κ)} {r : ℕ}
  {v : ∀ i,Grain α η r (f i)}

/-- A paid native projection of an augmented tape to the original banks.
Each original output is read and written; all scratch outputs have already
been explicitly cleared by the bank DAG's final native point pass. -/
theorem extract_original
    (h : Rig m B f s x cl X R r (fun i => padded (κ:=κ) (v i))) :
    Can m B s (bundle cl) x
      (fun i => (fleet X R0 r (f i)).tape (v i))
      (fun i => (fleet X R0 r (f i)).n) := by
  have Hsize : Knows m B s x (fun i => (fleet X R0 r (f i)).n) :=
    (Can.wc R0.n).times (h.gear.grid_size X r)
      (Small.const B R0.n) (h.gear.grid_small X r)
  have Hsmall : Small B (fun i => (fleet X R0 r (f i)).n) :=
    (Small.const B R0.n).mul (h.gear.grid_small X r)
  have H := Can.layout (t:=c cl) (P:=fun _ => 0)
    (L:=fun i => fleet X R0 r (f i)) (v:=v) Hsize ?_ Hsmall
  · simpa only [Nat.zero_add,Nat.mul_zero,Nat.add_zero] using H
  · let Q := Σ i,Beach α η r (f i)
    let env (d : Q) : T (p s w) := (x d.1,(fleet X R0 r (f d.1)).loc d.2)
    have hg := h.gather (fun d : Q => d.1) env (t:=p s w) Can.first
    have hs := Hsmall.reindex (fun d : Q => d.1)
    have hl : Knows m (fun d : Q => B d.1) (p s w) env
        (fun d => R0.loc d.2.1) :=
      Can.addr_high (u:=fun d : Q => d.2) (L:=fun _ => R0)
        (R:=fun d : Q => book X r (f d.1)) Can.second
        (hg.gear.grid_size X r) hs
    have hk : Knows m (fun d : Q => B d.1) (p s w) env
        (fun d => (book X r (f d.1)).loc d.2.2) :=
      Can.addr_low (u:=fun d : Q => d.2) (L:=fun _ => R0)
        (R:=fun d : Q => book X r (f d.1)) Can.second
        (hg.gear.grid_size X r) hs
    apply Can.cases_code (q:=fun d : Q => d.2.1) R0 hl
    intro j
    have HR := hg.read (fun d : Q => (Sum.inl j,d.2.2))
      (Can.wc (R.loc (Sum.inl j))) hk
    refine (HR.reindex (fun d : {d : Q // d.2.1=j} => d.1)).cong
      (fun _ => rfl) (fun d => ?_)
    change v d.1.1 (j,d.1.2.2)=v d.1.1 d.1.2
    exact congrArg (v d.1.1) (Prod.ext d.2.symm rfl)

/-- Compile a certified bank DAG, clear its scratch and extract all original
kernel outputs.  This is actual native code, with only smaller-kernel
contracts borrowed.  Its complete callback bill is the physical node bill. -/
theorem macro_native (b : Bank (hatch cl) ι)
    (h : Rig m b.B f s x cl X R0 r v) (R : Layout (η⊕κ)) (j : η)
    (hr : 3≤X.n) (A : (η⊕κ)→OBase α) (tau : ι→ℕ→ℕ)
    (HC : ∀ n : ℕ,0<n → n≤X.n → GroupedResidual.Rig.RawContract cl b
      (fun i => n*f i) (fun i => tau i (n*f i)))
    (nodes : List (Node α η κ)) (D : Matrix η (η⊕κ) ℚ)
    (H : KernelDAG A nodes D) :
    Able m b s (bundle cl) x
      (fun i => (fleet X R0 r (f i)).tape (kernelGrain (v i)))
      (fun i => (fleet X R0 r (f i)).n)
      (fun i => (nodes.map (nodeCharge X r (f i) (tau i))).sum) := by
  have HN := fresh_native b h R j hr A tau HC nodes D
  have HN' : Able m b s (bundle cl) x
      (fun i => (fleet X R r (f i)).tape (padded (κ:=κ) (kernelGrain (v i))))
      (fun i => (fleet X R0 r (f i)).n)
      (fun i => (nodes.map (nodeCharge X r (f i) (tau i))).sum) := by
    simpa only [coastline_kernel A nodes D H] using HN
  let env i : T (p s (bundle cl)) :=
    (x i,(fleet X R r (f i)).tape (padded (κ:=κ) (kernelGrain (v i))))
  have hg := h.gather id env (t:=p s (bundle cl)) Can.first
  have hp : Rig m b.B f (p s (bundle cl)) env cl X R r
      (fun i => padded (κ:=κ) (kernelGrain (v i))) :=
    ⟨hg.gear,hg.imag,Can.second⟩
  have HE := extract_original (R0:=R0) hp
  have HT := HN'.save_keep (Able.of_can (b:=b) HE)
  simpa only [Nat.add_zero] using HT

end Native

theorem complete_physical (X : Layout α) (R0 : Layout η) (a r f k : ℕ)
    (hR : R0.n=2^a) (hk : X.n*f+r+a=k) (v : Bits k→ℂ)
    (q : Beach α η r f) :
    let e := physicalSerial X R0 a r f k hR hk
    roleKernelPoint (roleIndex R0 hR)
      (kernelGrain (remnant r f (fun q => v (e q)))) q =
      ripple k v (e q) := by
  intro e
  unfold roleKernelPoint kernelGrain
  change (∑ l,kernel (Fin a) _ _ *
    ∑ z,digitProd (fun _ : Fin f => kernel α) q.2.2 z *
      ∑ t,kernel (Fin r) q.2.1 t * v (e (l,t,z))) =
    ∑ z,kernel (Fin k) (e q) z*v z
  rw [← Equiv.sum_comp e]
  simp_rw [Fintype.sum_prod_type]
  have HK (z : Beach α η r f) : kernel (Fin k) (e q) (e z)=
      kernel (Fin a) (roleIndex R0 hR q.1) (roleIndex R0 hR z.1)*
        kernel (Fin r) q.2.1 z.2.1*
        digitProd (fun _ : Fin f => kernel α) q.2.2 z.2.2 :=
    kernel_physical X R0 a r f k hR hk q z
  simp_rw [HK]
  simp only [mul_sum]
  apply sum_congr rfl
  intro l hl
  rw [sum_comm]
  apply sum_congr rfl
  intro t ht
  apply sum_congr rfl
  intro z hz
  ring

end
end FourierSchur.OriginalScratchGroupedBodyRAM
